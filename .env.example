# Copy to .env (repo root) and fill in. Never commit .env.

# Postgres (matches docker-compose.yml). Async driver for SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://jdlens:jdlens@localhost:5432/jdlens

# LLM provider (any provider with JSON output mode; Gemini free tier is cheapest).
# Check the provider's current model names and free-tier limits before starting.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=30

# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
