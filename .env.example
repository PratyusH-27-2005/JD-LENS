# Copy to .env (repo root) and fill in. Never commit .env.

# Postgres. docker-compose default below, or paste Neon's connection string as-is
# (postgresql://...?sslmode=require): the app converts it for the async driver.
DATABASE_URL=postgresql+asyncpg://jdlens:jdlens@localhost:5432/jdlens
# API tests only. They TRUNCATE tables: must be a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql+asyncpg://jdlens:jdlens@localhost:5432/jdlens_test

# LLM provider (any provider with JSON output mode; Gemini free tier is cheapest).
# Check the provider's current model names and free-tier limits before starting.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=30

# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Optional regex for extra origins, e.g. Vercel previews: https://jd-lens(-[\w-]+)?\.vercel\.app
ALLOWED_ORIGIN_REGEX=
# POST /postings per client IP (slowapi syntax). Protects the LLM key on the public demo.
RATE_LIMIT_POSTINGS=10/minute
RATE_LIMIT_RESUME=5/minute

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
